# ─────────────────────────────────────────────────────────────────────────────
# Bizak backend API origin for public form submissions.
# The contact, partner and careers forms POST to:
#     {VITE_API_BASE_URL}/api/contact-us/save
#
# BUILD-TIME variable: Vite bakes it into the static bundle at `npm run build`,
# so changing it requires a rebuild + redeploy.
#
# ⚠️  Confirm the correct origin — the repo is internally inconsistent:
#       package.json homepage   → https://bizakerp.com
#       app CTAs                → https://system.bizakerp.com
#       backend CORS allow-list → *.bizakerp.com.np   (backend Startup.cs)
#     The production website origin must ALSO be in the backend CORS allow-list
#     (Cors:AllowedOrigins in appsettings, or the host rule in Startup.cs) or the
#     browser will block the cross-origin POST.
#
# Local development (localhost is already allowed by the backend CORS policy):
#     VITE_API_BASE_URL=https://localhost:5001
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://system.bizakerp.com
